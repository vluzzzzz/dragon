# Mercado Pago — Access Token de producción (APP_USR-xxxx)
MERCADO_PAGO_ACCESS_TOKEN=

# Resend — API Key (re_xxxx)
RESEND_API_KEY=

# Correo donde llegan las notificaciones de pedidos
NOTIFICATION_EMAIL=

# URL base del frontend (ej: https://airpods-store.vercel.app)
FRONTEND_URL=

# ── Supabase (panel de administración) ──
# OJO: la URL y la ANON KEY van en js/supabase-config.js (son PÚBLICAS, no secretas).
# No se ponen acá. Esto es solo recordatorio.
#   SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_ANON_KEY=eyJhbGciOi...
# La SERVICE ROLE KEY (secreta) solo haría falta si más adelante agregamos una
# función serverless de subida de imágenes con conversión a webp:
# SUPABASE_SERVICE_ROLE_KEY=
